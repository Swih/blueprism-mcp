{
  "name": "@bpdev/generator",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic generation of Blue Prism 7.5.1 objects and test processes from a typed IR.",
  "type": "module",
  "exports": {
    ".": {
      "@bpdev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@bpdev/model": "0.0.0",
    "@bpdev/catalog": "0.0.0",
    "zod": "^4.6.5",
    "uuid": "^14.0.2"
  }
}
