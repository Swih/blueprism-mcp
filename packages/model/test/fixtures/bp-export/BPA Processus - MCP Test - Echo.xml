<?xml version="1.0" encoding="utf-8"?>
<process name="MCP Test - Echo" version="1.0" bpversion="7.5.1.18099" narrative="Harmless test process for MCP servers: echoes a greeting, optionally waits, optionally raises an exception. Touches no application, file or network." byrefcollection="true" preferredid="6d1c2f0e-4b7a-4c55-9a3e-0e5b7c3d9a01" published="true" published_type="2">
  <view>
    <camerax>0</camerax>
    <cameray>0</cameray>
    <zoom version="2">1.25</zoom>
  </view>
  <preconditions />
  <endpoint narrative="" />
  <stage stageid="a0000000-0000-4000-8000-000000000001" name="Info" type="ProcessInfo">
    <display x="-195" y="-150" w="150" h="90" />
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000002" name="Start" type="Start">
    <display x="15" y="-150" />
    <inputs>
      <input type="text" name="name" narrative="Who to greet" stage="name" />
      <input type="number" name="wait_seconds" narrative="Seconds to wait before finishing (0 = no wait)" stage="wait_seconds" />
      <input type="flag" name="fail" narrative="True to raise an intentional exception" stage="fail" />
    </inputs>
    <onsuccess>a0000000-0000-4000-8000-000000000003</onsuccess>
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000003" name="Fail requested?" type="Decision">
    <display x="15" y="-90" />
    <decision expression="[fail]" />
    <ontrue>a0000000-0000-4000-8000-000000000004</ontrue>
    <onfalse>a0000000-0000-4000-8000-000000000005</onfalse>
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000004" name="Raise test exception" type="Exception">
    <display x="120" y="-90" />
    <exception localized="yes" type="MCP Test Exception" detail="&quot;Intentional failure requested by caller&quot;" />
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000005" name="Build greeting" type="Calculation">
    <display x="15" y="-30" />
    <onsuccess>a0000000-0000-4000-8000-000000000006</onsuccess>
    <calculation expression="&quot;Hello &quot; &amp; [name] &amp; &quot; from Blue Prism&quot;" stage="greeting" />
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000006" name="Wait" type="WaitStart">
    <display x="15" y="30" />
    <groupid>a0000000-0000-4000-8000-0000000000ff</groupid>
    <choices />
    <timeout>[wait_seconds]</timeout>
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000007" name="Time Out" type="WaitEnd">
    <display x="75" y="30" />
    <groupid>a0000000-0000-4000-8000-0000000000ff</groupid>
    <onsuccess>a0000000-0000-4000-8000-000000000008</onsuccess>
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000008" name="Stamp time" type="Calculation">
    <display x="15" y="90" />
    <onsuccess>a0000000-0000-4000-8000-000000000009</onsuccess>
    <calculation expression="Now()" stage="finished_at" />
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000009" name="End" type="End">
    <display x="15" y="150" />
    <outputs>
      <output type="text" name="greeting" narrative="The greeting built from the input" stage="greeting" />
      <output type="datetime" name="finished_at" narrative="When the process finished" stage="finished_at" />
    </outputs>
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000010" name="name" type="Data">
    <display x="195" y="-150" />
    <datatype>text</datatype>
    <initialvalue />
    <private />
    <alwaysinit />
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000011" name="wait_seconds" type="Data">
    <display x="270" y="-150" />
    <datatype>number</datatype>
    <initialvalue>0</initialvalue>
    <private />
    <alwaysinit />
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000012" name="fail" type="Data">
    <display x="345" y="-150" />
    <datatype>flag</datatype>
    <initialvalue>False</initialvalue>
    <private />
    <alwaysinit />
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000013" name="greeting" type="Data">
    <display x="195" y="-90" />
    <datatype>text</datatype>
    <initialvalue />
    <private />
    <alwaysinit />
  </stage>
  <stage stageid="a0000000-0000-4000-8000-000000000014" name="finished_at" type="Data">
    <display x="270" y="-90" />
    <datatype>datetime</datatype>
    <initialvalue />
    <private />
    <alwaysinit />
  </stage>
</process>