{
  "name": "@bpdev/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Local MCP server for building and diagnosing Blue Prism automations.",
  "type": "module",
  "exports": {
    ".": {
      "@bpdev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
