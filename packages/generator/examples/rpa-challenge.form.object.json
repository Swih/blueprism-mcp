{
  "name": "BPDEV RPA Challenge - Form",
  "description": "Screen object inspired by the reference object conventions. Shared Attach and Set Field helpers; named public actions. Labels are the anchors, never shuffled IDs or positions.",
  "runMode": "Exclusive",
  "application": {
    "kind": "BrowserAttach",
    "name": "RPA Challenge",
    "parameters": {
      "WindowTitle": "Rpa Challenge*",
      "Path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
    }
  },
  "elements": [
    {
      "key": "start",
      "name": "Home - Start",
      "type": "WebButton",
      "match": { "wElementType": "BUTTON", "wXPath": "//button[normalize-space(.) = 'Start']" }
    },
    {
      "key": "submit",
      "name": "Form - Submit",
      "type": "WebButton",
      "match": {
        "wElementType": "INPUT",
        "wXPath": "//input[@type = 'submit' and @value = 'Submit']"
      }
    },
    {
      "key": "round",
      "name": "Home - Expected Round",
      "type": "WebButton",
      "match": { "wElementType": "BUTTON" },
      "dynamic": ["wXPath"],
      "rationale": "Match the expected next round in the DOM after clicking. Never retry a submission merely because confirmation timed out."
    },
    {
      "key": "field",
      "name": "Form - Input by label",
      "type": "WebTextEdit",
      "match": {
        "wElementType": "INPUT"
      },
      "dynamic": ["wXPath"],
      "rationale": "The calling action passes a label-anchored XPath through a BP elementparameter. Wait/Write/Read use exactly the same XPath."
    }
  ],
  "actions": [
    {
      "name": "Click Button - Start",
      "description": "Attach, wait for Start, click once, and wait until round 1 is displayed.",
      "inputs": [
        {
          "name": "Wait Timeout",
          "type": "number",
          "description": "Maximum seconds to wait for a state",
          "defaultValue": 5
        }
      ],
      "outputs": [],
      "steps": [
        { "kind": "callPage", "page": "Attach" },
        {
          "kind": "waitFor",
          "element": "start",
          "name": "Wait Start",
          "timeoutSeconds": "[Wait Timeout]",
          "onTimeout": { "type": "System Exception", "detail": "Start button was not available." }
        },
        { "kind": "act", "element": "start", "action": "WebClick", "name": "Click Start" },
        {
          "kind": "waitFor",
          "element": "round",
          "params": { "wXPath": "\"//button[normalize-space(.) = 'Round 1']\"" },
          "name": "Wait Round",
          "timeoutSeconds": "[Wait Timeout]",
          "onTimeout": {
            "type": "System Exception",
            "detail": "Round 1 was not confirmed after Start."
          }
        }
      ]
    },
    {
      "name": "Click Button - Submit",
      "description": "Click Submit once, then verify the expected next round. An ambiguous outcome propagates; never resubmit automatically.",
      "inputs": [
        {
          "name": "Next Round XPath",
          "type": "text",
          "description": "Unique label-anchored XPath for the expected next round, generated by the process builder"
        },
        {
          "name": "Wait Timeout",
          "type": "number",
          "description": "Maximum seconds to wait for a state",
          "defaultValue": 5
        }
      ],
      "outputs": [],
      "steps": [
        { "kind": "callPage", "page": "Attach" },
        {
          "kind": "waitFor",
          "element": "submit",
          "name": "Wait Submit",
          "timeoutSeconds": "[Wait Timeout]",
          "onTimeout": { "type": "System Exception", "detail": "Submit button was not available." }
        },
        { "kind": "act", "element": "submit", "action": "WebClick", "name": "Click Submit" },
        {
          "kind": "waitFor",
          "element": "round",
          "params": { "wXPath": "[Next Round XPath]" },
          "name": "Wait Round",
          "timeoutSeconds": "[Wait Timeout]",
          "onTimeout": {
            "type": "System Exception",
            "detail": "Expected next round was not confirmed after Submit. Outcome is unknown; do not blindly replay this action."
          }
        }
      ]
    },
    {
      "name": "Attach",
      "description": "Check attachment before touching the page. Reuse this helper from screen actions.",
      "published": false,
      "inputs": [],
      "outputs": [],
      "steps": [
        {
          "kind": "ensureAttached",
          "args": {
            "WindowTitle": "\"Rpa Challenge*\"",
            "ProcessName": "\"chrome\""
          }
        }
      ]
    },
    {
      "name": "Set Field",
      "description": "Attach, wait for the field, write, wait until its value agrees, then read back. Propagate errors; recovery policy belongs to the process.",
      "published": false,
      "inputs": [
        {
          "name": "Field XPath",
          "type": "text",
          "description": "Resolved unique XPath of the intended field"
        },
        {
          "name": "Value",
          "type": "text",
          "description": "Text to write"
        },
        {
          "name": "Wait Timeout",
          "type": "number",
          "description": "Maximum seconds to wait for the target state",
          "defaultValue": 5
        }
      ],
      "outputs": [
        {
          "name": "Actual Value",
          "type": "text",
          "description": "Independently read value after writing"
        }
      ],
      "steps": [
        {
          "kind": "callPage",
          "page": "Attach"
        },
        {
          "kind": "waitFor",
          "element": "field",
          "name": "Wait Field",
          "params": {
            "wXPath": "[Field XPath]"
          },
          "timeoutSeconds": "[Wait Timeout]",
          "onTimeout": {
            "type": "System Exception",
            "detail": "Field was not found using its label-anchored XPath."
          }
        },
        {
          "kind": "write",
          "name": "Write Value",
          "element": "field",
          "params": {
            "wXPath": "[Field XPath]"
          },
          "value": "[Value]"
        },
        {
          "kind": "waitFor",
          "element": "field",
          "params": {
            "wXPath": "[Field XPath]"
          },
          "condition": "WebCheckValue",
          "name": "Wait Value",
          "expected": "[Value]",
          "timeoutSeconds": "[Wait Timeout]",
          "onTimeout": {
            "type": "System Exception",
            "detail": "Field did not reach the expected value after writing."
          }
        },
        {
          "kind": "read",
          "name": "Read Value",
          "element": "field",
          "params": {
            "wXPath": "[Field XPath]"
          },
          "action": "WebGetValue",
          "into": "Actual Value"
        }
      ]
    },
    {
      "name": "Set Field First Name",
      "description": "Set First Name regardless of its current order or random id.",
      "published": true,
      "inputs": [
        {
          "name": "Value",
          "type": "text",
          "description": "Text to write to First Name"
        },
        {
          "name": "Wait Timeout",
          "type": "number",
          "description": "Maximum seconds to wait for the target state",
          "defaultValue": 5
        }
      ],
      "outputs": [
        {
          "name": "Actual Value",
          "type": "text",
          "description": "Read-back value from First Name"
        }
      ],
      "steps": [
        {
          "kind": "callPage",
          "page": "Set Field",
          "inputs": {
            "Field XPath": "\"//label[normalize-space(.) = 'First Name']/following-sibling::input\"",
            "Value": "[Value]",
            "Wait Timeout": "[Wait Timeout]"
          },
          "outputs": {
            "Actual Value": "Actual Value"
          }
        }
      ]
    },
