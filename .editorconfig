root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{cs,ps1}]
indent_size = 4

# Blue Prism files are kept byte for byte as produced (BOM, CRLF).
[*.{bpprocess,bpobject,bprelease,xml}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
