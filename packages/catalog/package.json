{
  "name": "@bpdev/catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Blue Prism Application Manager catalogue (element types, actions, conditions, identifiers).",
  "type": "module",
  "exports": {
    ".": {
      "@bpdev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
